<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Our own Developer Disk Image mirrors, tried before jsDelivr and GitHub
	     (DeveloperDiskImageStore.sources). Each entry is an https base URL
	     laid out like the upstream repository's root, e.g. https://cdn.example.com/ddi
	     -> .../PersonalizedImages/Xcode_iOS_DDI_Personalized/Image.dmg and
	     .../DeveloperDiskImages/16.4/DeveloperDiskImage.dmg.
	     Files must be the ones pinned in DeveloperDiskImageStore: every
	     download is checked against its SHA-256. Empty: no mirror of our own. -->
	<!-- The languages the in-code string tables cover. Declared so system
	     controls (PasteButton, pickers) and formatters follow the user's
	     language instead of falling back to English: the app has no .lproj. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
	</array>
	<key>LoopCtrlDDIMirrors</key>
	<array/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.openminis.loopctrl.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>loopctrl-app</string>
			</array>
		</dict>
	</array>
	<!-- Pairing files can be shared to LoopCtrl ("Open in" / share sheet) from
	     Files, Mail, AirDrop or a chat app, for when the in-app picker cannot
	     reach the file. Alternate rank: LoopCtrl is offered, never the default
	     opener for property lists. Copied in (not opened in place) and
	     validated before it is stored. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Pairing File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.openminis.loopctrl.pairing-record</string>
				<string>com.apple.property-list</string>
				<string>public.xml</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.openminis.loopctrl.pairing-record</string>
			<key>UTTypeDescription</key>
			<string>Device Pairing Record</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.property-list</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mobiledevicepairing</string>
					<string>mobiledevicepair</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>NSBonjourServices</key>
	<array>
		<string>_loopctrl._tcp</string>
		<string>_remotepairing-pairable-host._tcp</string>
	</array>
	<!-- Keeps the on-device pairing listener alive (BGContinuedProcessingTask)
	     while the user is in Settings entering the PIN. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).pairing</string>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>loopctrl</string>
		<string>stikdebug</string>
		<string>stikjit</string>
		<string>localdevvpn</string>
		<string>shadowrocket</string>
	</array>
</dict>
</plist>
