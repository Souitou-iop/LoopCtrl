<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.openminis.ictrl.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ictrl-app</string>
			</array>
		</dict>
		<!-- All-in-one: this app is also the runner, so it answers ictrl://
		     (start/stop and the callbacks clients use) instead of a separate
		     iCTRLUITests-Runner. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.openminis.ictrl</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ictrl</string>
			</array>
		</dict>
	</array>
	<!-- Copied from Xcode's XCTRunner.app template, which every runner carries.
	     Keeps the process alive while it serves from the background; the test
	     also gets testmanagerd's per-pid background assertion, which does not
	     depend on this key, but nothing so far has run without it. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>continuous</string>
	</array>
	<!-- Pairing files can be shared to iCTRL ("Open in" / share sheet) from
	     Files, Mail, AirDrop or a chat app, for when the in-app picker cannot
	     reach the file. Alternate rank: iCTRL is offered, never the default
	     opener for property lists. Copied in (not opened in place) and
	     validated before it is stored. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Pairing File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.openminis.ictrl.pairing-record</string>
				<string>com.apple.property-list</string>
				<string>public.xml</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.openminis.ictrl.pairing-record</string>
			<key>UTTypeDescription</key>
			<string>Device Pairing Record</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.property-list</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mobiledevicepairing</string>
					<string>mobiledevicepair</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>NSBonjourServices</key>
	<array>
		<string>_ictrl._tcp</string>
		<string>_remotepairing-pairable-host._tcp</string>
	</array>
	<!-- Keeps the on-device pairing listener alive (BGContinuedProcessingTask)
	     while the user is in Settings entering the PIN. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).pairing</string>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>stikdebug</string>
		<string>stikjit</string>
		<string>localdevvpn</string>
		<string>shadowrocket</string>
	</array>
</dict>
</plist>
