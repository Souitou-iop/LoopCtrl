    <string name="err_noUsbmux_title">The built-in USB service is not running</string>
    <string name="err_noUsbmux_body">The assistant cannot see iPhones right now.</string>
    <string-array name="err_noUsbmux_steps">
        <item>Quit the assistant completely and open it again</item>
        <item>Restart this Android phone</item>
        <item>Come back and tap “Check again”</item>
    </string-array>
    <string name="err_noHost_title">This phone has no USB host support</string>
    <string name="err_noHost_body">It cannot connect to an iPhone by cable (no OTG). Use another Android phone or the computer version.</string>
    <string name="err_untrusted_title">The iPhone did not trust this device</string>
    <string name="err_untrusted_body">“Don\'t Trust” was tapped on the iPhone.</string>
    <string-array name="err_untrusted_steps">
        <item>Unplug the cable, wait two seconds, plug it in again</item>
        <item>Unlock the iPhone and tap “Trust” this time</item>
        <item>Enter the passcode</item>
    </string-array>
    <string name="err_untrusted_hint">No prompt after replugging: Settings › General › Transfer or Reset iPhone › Reset › Reset Location &amp; Privacy.</string>
    <string name="err_devModeCancelled_title">Developer Mode is still off</string>
    <string name="err_devModeCancelled_body">The prompt after the restart was dismissed or cancelled. The switch is visible now; turn it on once more.</string>
    <string-array name="err_devModeCancelled_steps">
        <item>Settings › Privacy &amp; Security › Developer Mode</item>
        <item>Turn it on, tap “Restart”</item>
        <item>After the restart unlock and tap “Turn On”</item>
    </string-array>
    <string name="err_rebootTimeout_title">The iPhone has not come back</string>
    <string name="err_rebootTimeout_body">Waited 3 minutes.</string>
    <string-array name="err_rebootTimeout_steps">
        <item>Make sure the iPhone is on and has been unlocked once</item>
        <item>Check the cable; unplug and replug if needed and tap “OK” when Android asks</item>
        <item>Tap “Keep waiting”, or check again</item>
    </string-array>
    <string name="err_unsupported_title">This iPhone\'s iOS is too old</string>
    <string name="err_unsupported_body">LoopCtrl needs iOS 16 or later.</string>
    <string-array name="err_unsupported_steps">
        <item>Settings › General › Software Update: update to iOS 16 or later</item>
        <item>Reconnect the iPhone afterwards</item>
    </string-array>
    <string name="err_recordFailed_title">Couldn\'t create the pairing record</string>
    <string name="err_recordFailed_body">The iPhone refused the request, usually because it locked or the connection is unstable.</string>
    <string-array name="err_recordFailed_steps">
        <item>Unlock the iPhone and keep the screen on</item>
        <item>Try another cable or adapter</item>
        <item>Tap “Retry”</item>
    </string-array>
    <string name="err_appNotFound_title">LoopCtrl not found</string>
    <string name="err_appNotFound_body">The pairing file goes into LoopCtrl, which is not installed on this iPhone yet.</string>
    <string-array name="err_appNotFound_steps">
        <item>Install LoopCtrl on the iPhone</item>
        <item>Open it once, then go back to the Home Screen</item>
        <item>Tap “Retry”; keep the cable in</item>
    </string-array>
    <string name="err_writeFailed_title">Writing failed</string>
    <string name="err_writeFailed_body">LoopCtrl did not let the assistant write the file, usually because of how it was installed.</string>
    <string-array name="err_writeFailed_steps">
        <item>Make sure LoopCtrl was signed and installed as described in the guide</item>
        <item>Open LoopCtrl once, then go back to the Home Screen</item>
        <item>Tap “Retry”</item>
    </string-array>
    <string name="err_writeFailed_hint">The record is saved on this phone; a retry does not need Trust again.</string>
    <string name="err_verifyFailed_title">Verification failed</string>
    <string name="err_verifyFailed_body">The file was written, but the iPhone does not accept the record.</string>
    <string-array name="err_verifyFailed_steps">
        <item>Unlock the iPhone and keep the screen on</item>
        <item>Tap “Retry” to verify again</item>
        <item>Still failing: unplug and pair again</item>
    </string-array>
    <string name="err_disconnected_title">The iPhone was unplugged</string>
    <string name="err_disconnected_body">The cable came out in the middle of a step.</string>
    <string-array name="err_disconnected_steps">
        <item>Plug the cable back in and tap “OK” when Android asks</item>
        <item>Unlock the iPhone</item>
        <item>The assistant resumes from where it stopped</item>
    </string-array>
    <string name="err_internal_title">Something went wrong</string>
    <string name="err_internal_body">The assistant hit an unexpected error.</string>
    <string-array name="err_internal_steps">
        <item>Unplug and replug the cable</item>
        <item>Tap “Retry”</item>
        <item>Still failing: restart the assistant and send the details below to support</item>
    </string-array>
</resources>
