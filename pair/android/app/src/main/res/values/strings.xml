    <string name="err_noUsbmux_title">内置 USB 服务没有启动</string>
    <string name="err_noUsbmux_body">助手暂时识别不了 iPhone。</string>
    <string-array name="err_noUsbmux_steps">
        <item>完全退出助手后重新打开</item>
        <item>重启这台安卓手机</item>
        <item>回到这里点「重新检测」</item>
    </string-array>
    <string name="err_noHost_title">这台手机不支持 USB 主机</string>
    <string name="err_noHost_body">它不能通过数据线连接 iPhone（不支持 OTG），请换一台安卓手机或用电脑版。</string>
    <string name="err_untrusted_title">iPhone 没有信任这台设备</string>
    <string name="err_untrusted_body">刚才在 iPhone 上点了「不信任」。</string>
    <string-array name="err_untrusted_steps">
        <item>拔掉数据线，两秒后再插上</item>
        <item>解锁 iPhone，这次点「信任」</item>
        <item>输入锁屏密码</item>
    </string-array>
    <string name="err_untrusted_hint">插上后不再弹窗：设置 › 通用 › 传输或还原 iPhone › 还原 › 还原位置与隐私。</string>
    <string name="err_devModeCancelled_title">开发者模式没有打开</string>
    <string name="err_devModeCancelled_body">重启后的弹窗被关掉了，或者点了「取消」。开关已经露出来了，再打开一次就行。</string>
    <string-array name="err_devModeCancelled_steps">
        <item>设置 › 隐私与安全性 › 开发者模式</item>
        <item>打开开关，点「重新启动」</item>
        <item>重启后解锁，这次点「打开」</item>
    </string-array>
    <string name="err_rebootTimeout_title">iPhone 还没有连回来</string>
    <string name="err_rebootTimeout_body">已经等了 3 分钟。</string>
    <string-array name="err_rebootTimeout_steps">
        <item>确认 iPhone 已经开机，并且解锁过一次</item>
        <item>检查数据线有没有松动，可以拔下重插；安卓询问时点「确定」</item>
        <item>点「继续等待」，或者回到上一步重新检查</item>
    </string-array>
    <string name="err_unsupported_title">这台 iPhone 的系统太旧</string>
    <string name="err_unsupported_body">LoopCtrl 需要 iOS 16 或更高版本。</string>
    <string-array name="err_unsupported_steps">
        <item>设置 › 通用 › 软件更新，升级到 iOS 16 或更高</item>
        <item>升级后重新连接这台 iPhone</item>
    </string-array>
    <string name="err_recordFailed_title">没能生成配对记录</string>
    <string name="err_recordFailed_body">iPhone 拒绝了这次请求，常见原因是手机锁屏了或连接不稳定。</string>
    <string-array name="err_recordFailed_steps">
        <item>解锁 iPhone，保持亮屏</item>
        <item>换一根数据线或转接头</item>
        <item>点「重试」</item>
    </string-array>
    <string name="err_appNotFound_title">没有找到 LoopCtrl</string>
    <string name="err_appNotFound_body">配对文件要写进 LoopCtrl，但这台 iPhone 上还没有安装。</string>
    <string-array name="err_appNotFound_steps">
        <item>在 iPhone 上安装 LoopCtrl</item>
        <item>打开一次，再回到桌面</item>
        <item>点「重试」，数据线不用拔</item>
    </string-array>
    <string name="err_writeFailed_title">写入失败</string>
    <string name="err_writeFailed_body">LoopCtrl 不允许助手写入文件，通常是安装方式不对。</string>
    <string-array name="err_writeFailed_steps">
        <item>确认 LoopCtrl 是按教程签名安装的版本</item>
        <item>打开一次 LoopCtrl，再回到桌面</item>
        <item>点「重试」</item>
    </string-array>
    <string name="err_writeFailed_hint">配对记录已经保存在这台手机上，重试不需要再点「信任」。</string>
    <string name="err_verifyFailed_title">校验没有通过</string>
    <string name="err_verifyFailed_body">配对文件已写入，但 iPhone 不认这份记录。</string>
    <string-array name="err_verifyFailed_steps">
        <item>解锁 iPhone，保持亮屏</item>
        <item>点「重试」重新校验</item>
        <item>仍然失败：拔线后重新配对</item>
    </string-array>
    <string name="err_disconnected_title">iPhone 断开了连接</string>
    <string name="err_disconnected_body">操作进行到一半时数据线断开了。</string>
    <string-array name="err_disconnected_steps">
        <item>重新插上数据线，安卓询问时点「确定」</item>
        <item>解锁 iPhone</item>
        <item>助手会从断开的那一步自动继续</item>
    </string-array>
    <string name="err_internal_title">出了点问题</string>
    <string name="err_internal_body">助手遇到了没有预料到的错误。</string>
    <string-array name="err_internal_steps">
        <item>拔掉数据线后重新插上</item>
        <item>点「重试」</item>
        <item>仍然不行：重启助手，把下面的详细信息发给客服</item>
    </string-array>
</resources>
