    <string name="guide_trust_title">在 iPhone 上点「信任」</string>
    <string name="guide_trust_body">解锁 iPhone，在「要信任此电脑吗？」中点「信任」，然后输入锁屏密码。在 iPhone 看来这台安卓手机就是一台电脑。</string>
    <string name="guide_locked_title">先解锁 iPhone</string>
    <string name="guide_locked_body">iPhone 锁屏了，解锁后才会弹出「信任」。</string>
    <string name="guide_dev_off_title">打开开发者模式</string>
    <string name="guide_dev_off_body">开关已由助手显示出来。按苹果的规定，有锁屏密码的 iPhone 只能由机主亲手打开。</string>
    <string-array name="guide_dev_steps">
        <item>设置 › 隐私与安全性 › 开发者模式</item>
        <item>打开开关</item>
        <item>点「重新启动」，不要拔线</item>
    </string-array>
    <string name="guide_reboot_title">iPhone 正在重启</string>
    <string name="guide_reboot_body">大约 1 分钟。重新连上后自动继续；安卓可能会再问一次是否允许访问 iPhone，点「确定」即可。</string>
    <string name="guide_no_unplug">请不要拔数据线</string>
    <string name="guide_unlock_title">解锁并点「打开」</string>
    <string name="guide_unlock_body">iPhone 已重新连接。解锁后在「打开开发者模式？」中点「打开」，输入锁屏密码。</string>
    <string name="guide_no_prompt">没有看到弹窗？</string>
    <string name="guide_waiting">等待确认…</string>
    <string name="guide_elapsed">已等待 %1$s</string>
    <string name="guide_unplugged_title">iPhone 断开了</string>
    <string name="guide_unplugged_body">重新插上数据线并解锁，会从断开的那一步继续。</string>
    <string name="guide_skipped">这台会被跳过，不影响其他 iPhone。</string>
    <string name="guide_other">其他 iPhone 不受影响，会继续进行。</string>

