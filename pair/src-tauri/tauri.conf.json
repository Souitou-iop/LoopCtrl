{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoopCtrl Pair",
  "mainBinaryName": "LoopCtrl Pair",
  "identifier": "app.loopctrl.pair",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LoopCtrl 配对助手",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "shortDescription": "LoopCtrl 配对助手",
    "copyright": "© 2026 LoopCtrl contributors. Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/lib/udev/rules.d/70-loopctrl-pair.rules": "../packaging/linux/70-loopctrl-pair.rules"
        },
        "postInstallScript": "../packaging/linux/postinst.sh",
        "postRemoveScript": "../packaging/linux/postrm.sh"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "longDescription": "One-time USB pairing for LoopCtrl: makes the pairing file LoopCtrl needs on iOS 16 and later and writes it into the app."
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_MINISIGN_PUBLIC_KEY",
      "endpoints": [
        "https://updates.example.invalid/loopctrl-pair/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
