# Copy to relay.env (chmod 600). Never commit the real file.

# Bearer token for the admin endpoints (minting invites, listing phones), at
# least 24 characters:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
LOOPCTRL_RELAY_OPERATOR_TOKEN=

# How phones reach this relay: host[:port][/path], no scheme. Enrollment
# signatures are bound to it, so it must match the public URL exactly.
#   relay.example.com            (relay on its own name)
#   example.com/loopctrl-relay   (relay under a path on an existing site)
LOOPCTRL_RELAY_PUBLIC_SERVER=

# Give each phone its own address, https://<slug>.<this domain>/remote.
# Needs a wildcard DNS record and a wildcard certificate for it. Leave empty
# to serve phones at https://<public server>/d/<slug>/remote instead (one
# origin for every phone: only for phones that belong to one person).
LOOPCTRL_RELAY_DEVICE_DOMAIN=

# Shown on the phone when it previews an invite.
LOOPCTRL_RELAY_ORGANIZATION=LoopCtrl Relay

# One line per enrollment, sign-in and tunnel event (ids only; never tokens
# or request contents). 0 to turn off.
LOOPCTRL_RELAY_EVENT_LOG=1
